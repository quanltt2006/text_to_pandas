# LLM Provider: groq, openai or anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=qwen/qwen3.8-27b

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/smart_csv.db

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# RAG / retrieval strategy
EMBED_COLUMN_THRESHOLD=30
COLUMN_RETRIEVAL_TOP_K=10
VALUE_INDEX_MAX_UNIQUE=500
VALUE_INDEX_MAX_VALUES=200
FEW_SHOT_TOP_K=3
SCHEMA_MAX_INLINE_COLUMNS=30
MAX_FIX_ATTEMPTS=2

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# Sandbox
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=256

# Security
SECRET_KEY=change-this-to-a-random-secret-key
API_KEY_HEADER=X-API-Key